  "$id": "urn:plebian:candidate:schema:f106-invocation-contract:v0-draft",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate": {
      "const": true
    },
    "commands": {
      "items": false,
      "maxItems": 9,
      "minItems": 9,
      "prefixItems": [
        {
          "$ref": "#/$defs/hardwareShow"
        },
        {
          "$ref": "#/$defs/hardwareInventory"
        },
        {
          "$ref": "#/$defs/hardwareGpu"
        },
        {
          "$ref": "#/$defs/sizerRecommendTts"
        },
        {
          "$ref": "#/$defs/sizerPlan"
        },
        {
          "$ref": "#/$defs/sizerInstall"
        },
        {
          "$ref": "#/$defs/sizerInstallStatus"
        },
        {
          "$ref": "#/$defs/sizerInstallCancel"
        },
        {
          "$ref": "#/$defs/sizerSnapshot"
        }
      ],
      "type": "array",
      "uniqueItems": true
    },
    "environment": {
      "additionalProperties": false,
      "properties": {
        "executable_resolution": {
          "const": "absolute-installed-paths-only"
        },
        "locale": {
          "const": "C.UTF-8"
        },
        "network": {
          "const": "not-required"
        },
        "stdin": {
          "const": "dev-null"
        }
      },
      "required": [
        "executable_resolution",
        "locale",
        "network",
        "stdin"
      ],
      "type": "object"
    },
    "exit_statuses": {
      "additionalProperties": false,
      "properties": {
        "0": {
          "const": "contract-valid result, including unknown or blocked"
        },
        "2": {
          "const": "command-line usage error"
        },
        "65": {
          "const": "invalid input document"
        },
        "69": {
          "const": "required local dependency unavailable"
        },
        "70": {
          "const": "internal invariant failure"
        },
        "75": {
          "const": "temporary local failure"
        }
      },
      "required": [
        "0",
        "2",
        "65",
        "69",
        "70",
        "75"
      ],
      "type": "object"
    },
    "limits": {
      "additionalProperties": false,
      "properties": {
        "diagnostic_bytes": {
          "const": 4096
        },
        "read_only_timeout_seconds": {
          "const": 15
        },
        "stdout_bytes": {
          "const": 4194304
        }
      },
      "required": [
        "diagnostic_bytes",
        "read_only_timeout_seconds",
        "stdout_bytes"
      ],
      "type": "object"
    },
    "renderer_limits": {
      "additionalProperties": false,
      "properties": {
        "authorization_receipts": {
          "const": 256
        },
        "blockers": {
          "const": 64
        },
        "fit_reasons": {
          "const": 64
        },
        "fit_resources": {
          "const": 4
        },
        "plan_items": {
          "const": 256
        },
        "profile_catalog_ids": {
          "const": 256
        },
        "unknowns": {
          "const": 256
        },
        "warnings": {
          "const": 64
        }
      },
      "required": [
        "warnings",
        "fit_reasons",
        "fit_resources",
        "blockers",
        "plan_items",
        "authorization_receipts",
        "profile_catalog_ids",
        "unknowns"
      ],
      "type": "object"
    },
    "schema": {
      "const": "f106.invocation-contract/v0-draft"
    },
    "streams": {
      "additionalProperties": false,
      "properties": {
        "nonzero": {
          "additionalProperties": false,
          "properties": {
            "stderr": {
              "const": "one redacted UTF-8 line followed by LF"
            },
            "stdout": {
              "const": "empty"
            }
          },
          "required": [
            "stderr",
            "stdout"
          ],
          "type": "object"
        },
        "success": {
          "additionalProperties": false,
          "properties": {
            "stderr": {
              "const": "empty"
            },
            "stdout": {
              "const": "one document followed by LF"
            }
          },
          "required": [
            "stderr",
            "stdout"
          ],
          "type": "object"
        }
      },
      "required": [
        "success",
        "nonzero"
      ],
      "type": "object"
    },
    "transaction_lifecycle": {
      "additionalProperties": false,
      "properties": {
        "cancellation": {
          "const": "idempotent-request-stop-before-next-item-preserve-completed-item-receipts"
        },
        "confirmation_binding": {
          "const": "consumer-confirmation-and-resume-state-carry-the-reviewed-plan-sha256"
        },
        "idempotency_key": {
          "const": "plan-sha256-plus-sorted-authorization-receipt-sha256s"
        },
        "plan_binding": {
          "const": "provider-compares-sha256-of-exact-canonical-reviewed-plan-bytes-before-any-mutation"
        },
        "retry": {
          "const": "same-plan-and-receipts-resume-or-return-terminal"
        },
        "revalidation": {
          "const": "execution-start-and-before-each-item"
        },
        "states": {
          "const": [
            "blocked",
            "queued",
            "running",
            "interrupted",
            "cancelling",
            "cancelled",
            "succeeded",
            "failed",
            "unknown"
          ]
        },
        "terminal_states": {
          "const": [
            "blocked",
            "cancelled",
            "succeeded",
            "failed"
          ]
        }
      },
      "required": [
        "plan_binding",
        "confirmation_binding",
        "idempotency_key",
        "states",
        "terminal_states",
        "retry",
        "cancellation",
        "revalidation"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema",
    "candidate",
    "environment",
    "limits",
    "renderer_limits",
    "streams",
    "transaction_lifecycle",
    "exit_statuses",
    "commands"
  ],
  "title": "Candidate F106 invocation contract",
  "type": "object"
}
