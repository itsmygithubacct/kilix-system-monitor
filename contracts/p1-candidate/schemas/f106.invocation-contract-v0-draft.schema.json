          ]
        },
        "command_id": {
          "const": "sizer.install.status"
        },
        "data_schema": {
          "const": "plebian.models.install-transaction/v1"
        },
        "fixture": {
          "const": "fixtures/responses/sizer-install-status-blocked.json"
        },
        "side_effects": {
          "const": "none"
        },
        "stdout": {
          "const": "plebian.cli.response/v1"
        }
      },
      "required": [
        "data_schema"
      ]
    },
    "sizerPlan": {
      "$ref": "#/$defs/command",
      "properties": {
        "argv": {
          "const": [
            "/usr/bin/plebian-model-sizer",
            "plan",
            "local-ai-balanced",
            "--json"
          ]
        },
        "command_id": {
          "const": "sizer.plan.local-ai-balanced"
        },
        "data_schema": {
          "const": "plebian.models.install-plan/v1"
        },
        "fixture": {
          "const": "fixtures/responses/sizer-plan.json"
        },
        "side_effects": {
          "const": "none"
        },
        "stdout": {
          "const": "plebian.cli.response/v1"
        }
      },
      "required": [
        "data_schema"
      ]
    },
    "sizerRecommendTts": {
      "$ref": "#/$defs/command",
      "properties": {
        "argv": {
          "const": [
            "/usr/bin/plebian-model-sizer",
            "recommend",
            "tts",
            "--json"
          ]
        },
        "command_id": {
          "const": "sizer.recommend.tts"
        },
        "data_schema": {
          "const": "plebian.models.fit-result/v1"
        },
        "fixture": {
          "const": "fixtures/responses/sizer-recommend-tts.json"
        },
        "side_effects": {
          "const": "none"
        },
        "stdout": {
          "const": "plebian.cli.response/v1"
        }
      },
      "required": [
        "data_schema"
      ]
    },
    "sizerSnapshot": {
      "$ref": "#/$defs/command",
      "properties": {
        "argv": {
          "const": [
            "/usr/bin/plebian-model-sizer",
            "snapshot",
            "--json"
          ]
        },
        "command_id": {
          "const": "sizer.snapshot"
        },
        "data_schema": {
          "const": "plebian.models.snapshot/v1"
        },
        "fixture": {
