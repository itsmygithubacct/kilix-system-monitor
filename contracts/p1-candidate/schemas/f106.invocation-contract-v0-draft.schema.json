{
  "$comment": "Track D/F107-B handoff candidate only; joint sign-off is required before a v1 freeze.",
  "$defs": {
    "command": {
      "additionalProperties": false,
      "properties": {
        "argv": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 2,
          "type": "array"
        },
        "command_id": {
          "enum": [
            "hardware.gpu",
            "hardware.inventory",
            "hardware.show",
            "sizer.install",
            "sizer.install.cancel",
            "sizer.install.status",
            "sizer.plan.local-ai-balanced",
            "sizer.recommend.tts",
            "sizer.snapshot"
          ]
        },
        "data_schema": {
          "enum": [
            "plebian.hardware/v1",
            "plebian.models.fit-result/v1",
            "plebian.models.install-plan/v1",
            "plebian.models.install-transaction/v1",
            "plebian.models.snapshot/v1"
          ]
        },
        "fixture": {
          "pattern": "^fixtures/responses/[a-z0-9][a-z0-9._-]*$",
          "type": "string"
        },
        "side_effects": {
          "enum": [
            "none",
            "none-when-blocked; provider-owned execution-after-revalidation-when-ready",
            "request-cancellation-only; provider-owned-coordinator-preserves-completed-items"
          ]
        },
        "stdout": {
          "enum": [
            "plebian.cli.response/v1",
            "text"
          ]
        }
      },
      "required": [
        "argv",
        "command_id",
        "fixture",
        "side_effects",
        "stdout"
      ],
      "type": "object"
    },
    "hardwareGpu": {
      "$ref": "#/$defs/command",
      "properties": {
        "argv": {
          "const": [
            "/usr/bin/plebian-hardware",
            "gpu",
            "--json"
          ]
        },
        "command_id": {
          "const": "hardware.gpu"
        },
        "data_schema": {
          "const": "plebian.hardware/v1"
        },
        "fixture": {
          "const": "fixtures/responses/hardware-gpu.json"
        },
        "side_effects": {
          "const": "none"
        },
        "stdout": {
          "const": "plebian.cli.response/v1"
        }
      },
      "required": [
        "data_schema"
      ]
    },
    "hardwareInventory": {
      "$ref": "#/$defs/command",
      "properties": {
        "argv": {
          "const": [
            "/usr/bin/plebian-hardware",
            "inventory",
            "--json"
          ]
        },
        "command_id": {
          "const": "hardware.inventory"
        },
        "data_schema": {
          "const": "plebian.hardware/v1"
        },
        "fixture": {
          "const": "fixtures/responses/hardware-inventory.json"
        },
        "side_effects": {
          "const": "none"
        },
        "stdout": {
          "const": "plebian.cli.response/v1"
        }
      },
      "required": [
        "data_schema"
      ]
    },
    "hardwareShow": {
      "$ref": "#/$defs/command",
      "not": {
        "required": [
          "data_schema"
        ]
      },
      "properties": {
        "argv": {
          "const": [
            "/usr/bin/plebian-hardware",
            "show"
          ]
        },
        "command_id": {
          "const": "hardware.show"
        },
        "fixture": {
          "const": "fixtures/responses/hardware-show.txt"
        },
        "side_effects": {
          "const": "none"
        },
        "stdout": {
          "const": "text"
        }
      }
    },
    "sizerInstall": {
      "$ref": "#/$defs/command",
      "properties": {
        "argv": {
          "const": [
            "/usr/bin/plebian-model-sizer",
            "install",
            "PLAN_PATH",
            "--expected-plan-sha256",
            "PLAN_SHA256",
            "--json"
          ]
        },
        "command_id": {
          "const": "sizer.install"
        },
        "data_schema": {
          "const": "plebian.models.install-transaction/v1"
        },
        "fixture": {
          "const": "fixtures/responses/sizer-install-blocked.json"
        },
        "side_effects": {
          "const": "none-when-blocked; provider-owned execution-after-revalidation-when-ready"
        },
        "stdout": {
          "const": "plebian.cli.response/v1"
        }
      },
      "required": [
        "data_schema"
      ]
    },
    "sizerInstallCancel": {
      "$ref": "#/$defs/command",
      "properties": {
        "argv": {
          "const": [
            "/usr/bin/plebian-model-sizer",
            "cancel",
            "TRANSACTION_ID",
            "--json"
          ]
        },
        "command_id": {
          "const": "sizer.install.cancel"
        },
        "data_schema": {
          "const": "plebian.models.install-transaction/v1"
        },
        "fixture": {
          "const": "fixtures/responses/sizer-install-cancel-blocked.json"
        },
        "side_effects": {
          "const": "request-cancellation-only; provider-owned-coordinator-preserves-completed-items"
        },
        "stdout": {
          "const": "plebian.cli.response/v1"
        }
      },
      "required": [
        "data_schema"
      ]
    },
    "sizerInstallStatus": {
      "$ref": "#/$defs/command",
      "properties": {
        "argv": {
          "const": [
            "/usr/bin/plebian-model-sizer",
