    "requirements": [
      {
        "requirement_id": "TLIF-01",
        "text": "canonical profile bytes have a frozen schema identity and SHA-256"
      },
      {
        "requirement_id": "TLIF-02",
        "text": "the ordered child table is profile data and has an independently recomputed terminal-set digest"
      },
      {
        "requirement_id": "TLIF-03",
        "text": "each subject preservation and authority root is separately retained with an exact no-follow manifest and no pathname reopen"
      },
      {
        "requirement_id": "TLIF-04",
        "text": "launcher bootstrap result-schema and profile-schema identities are exact frozen inputs"
      },
      {
        "requirement_id": "TLIF-05",
        "text": "the live interpreter binds path device inode and bytes rather than Python-reported strings alone"
      },
      {
        "requirement_id": "TLIF-06",
        "text": "the native launcher enforces one exact environment allowlist before subject code"
      },
      {
        "requirement_id": "TLIF-07",
        "text": "the native launcher starts from an empty external working directory"
      },
      {
        "requirement_id": "TLIF-08",
        "text": "initial module state and import path are checked before any subject authority import"
      },
      {
        "requirement_id": "TLIF-09",
        "text": "each child binds its entry kind path or module ordered argv and logical program"
      },
      {
        "requirement_id": "TLIF-10",
        "text": "each child authority and dependency root has a separately retained frozen no-follow closure"
      },
      {
        "requirement_id": "TLIF-11",
        "text": "bound interpreter bootstrap starts Python children without env shebang PATH or generated-console interpreter selection"
      },
      {
        "requirement_id": "TLIF-12",
        "text": "each child binds cwd environment stdin stdout stderr timeout and diagnostic limits"
      },
      {
        "requirement_id": "TLIF-13",
        "text": "subject runtime dependency and result closures are reverified after every child"
      },
      {
        "requirement_id": "TLIF-14",
        "text": "all child and descendant processes terminate before terminal promotion"
      },
      {
        "requirement_id": "TLIF-15",
        "text": "the result channel is unique bounded and unavailable to unintended descendants"
      },
      {
        "requirement_id": "TLIF-16",
        "text": "launcher and bootstrap independently compute the exact ordered terminal-check-set digest"
      },
      {
        "requirement_id": "TLIF-17",
        "text": "the canonical result binds run case profile subject authority launcher bootstrap interpreter and first-process identities"
      },
      {
        "requirement_id": "TLIF-18",
        "text": "cancellation kills every descendant and cannot publish or promote success"
      },
      {
        "requirement_id": "TLIF-19",
        "text": "pre-run and post-run preservation manifests prove subject and evidence bytes unchanged"
      },
      {
        "requirement_id": "TLIF-20",
        "text": "case and profile selection reach the native operator-facing launcher with no consumer pre-launch wrapper"
      }
