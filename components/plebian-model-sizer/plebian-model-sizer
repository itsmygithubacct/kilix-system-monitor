#!/usr/bin/env python3
"""Source-checkout launcher; installed builds use the console entry point."""
import sys
from pathlib import Path

sys.dont_write_bytecode = True
root = Path(__file__).resolve().parent
sys.path[:0] = [str(root / "src"), str(root.parent / "plebian-hardware" / "src")]
from plebian_model_sizer.cli import main

raise SystemExit(main())
